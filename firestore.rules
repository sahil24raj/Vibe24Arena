rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles include email and private preferences. Public views are filtered by the API.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, write: if false;
    }
    match /verifiedLeaderboards/{entry} {
      allow read: if true;
      allow write: if false;
    }
    // Trusted server endpoints own all writes and mask hidden game state.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
